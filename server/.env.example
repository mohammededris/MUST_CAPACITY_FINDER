# Backend Environment Variables
# Copy this file to server/.env and fill in your values

# Node Environment
NODE_ENV=production
PORT=5000

# MongoDB Connection String
# Get this from MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# Firebase Admin SDK (Backend) - Single line JSON
# Get from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Firebase Client Config (Frontend) - Get from Firebase Console > Project Settings > Your apps
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abc123

# CORS - Add your VM IP or domain
ALLOWED_ORIGINS=http://YOUR_VM_PUBLIC_IP

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
